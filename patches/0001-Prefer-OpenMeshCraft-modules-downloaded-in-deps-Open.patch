From aa3373535f2fbed8c0f6e819b1f27dfa6f54a0ea Mon Sep 17 00:00:00 2001
From: Bastien Nocera <hadess@hadess.net>
Date: Tue, 13 Oct 2026 11:11:11 +0200
Subject: [PATCH] Prefer OpenMeshCraft modules downloaded in deps/OpenMeshCraft

Prefer using OpenMeshCraft modules from well-known locations, such as
deps/${projectname}, making it easier for build systems to pre-download
archives for offline builds.

If the archive doesn't exist in deps/OpenMeshCraft, or its checksum
verification fails, try to use a previously downloaded copy from the
work directory, and verify its checksum. Download the archive if all
else fails.
---
 deps/OpenMeshCraft/OpenMeshCraft.cmake | 49 +++++++++++++++++++++-----
 1 file changed, 41 insertions(+), 8 deletions(-)

diff --git a/deps/OpenMeshCraft/OpenMeshCraft.cmake b/deps/OpenMeshCraft/OpenMeshCraft.cmake
index 6779262e4fd1..d6f916422260 100644
--- a/deps/OpenMeshCraft/OpenMeshCraft.cmake
+++ b/deps/OpenMeshCraft/OpenMeshCraft.cmake
@@ -31,20 +31,52 @@ if(NOT DEFINED OMC_SOURCE_DIR)
 endif()
 
 function(omc_fetch_zip url sha256 out_dir strip_prefix marker_file)
+  message(STATUS "[OpenMeshCraft] looking for '${marker_file}' in '${out_dir}'")
   if(EXISTS "${out_dir}/${marker_file}")
     message(STATUS "[OpenMeshCraft] Already present: ${out_dir}")
     return()
   endif()
   set(_workdir "${OMC_SOURCE_DIR}/.omc_fetch")
-  file(MAKE_DIRECTORY "${_workdir}")
-  set(_archive "${_workdir}/${strip_prefix}.zip")
-  message(STATUS "[OpenMeshCraft] Downloading ${url}")
-  file(DOWNLOAD "${url}" "${_archive}" EXPECTED_HASH SHA256=${sha256} SHOW_PROGRESS STATUS _st)
-  list(GET _st 0 _code)
-  if(NOT _code EQUAL 0)
-    list(GET _st 1 _msg)
-    message(FATAL_ERROR "[OpenMeshCraft] Download failed: ${_msg}")
+  # Try to use build system downloaded archive
+  set(_archive "${DOWNLOAD_DIR}/${strip_prefix}.zip")
+  set(_archive_fallback 0)
+  message(STATUS "[OpenMeshCraft] Checking ${_archive}")
+  if(EXISTS "${_archive}")
+    message(STATUS "[OpenMeshCraft] Checking SHA256 for ${_archive}")
+    file(SHA256 "${_archive}" _checksum)
+    string(TOLOWER "${sha256}" _sha256_lower)
+    if(NOT ${_checksum} STREQUAL ${_sha256_lower})
+      message(STATUS "[OpenMeshCraft] ${_archive} SHA256 failed (expected: ${_sha256_lower}, got: ${_checksum}")
+      set(_archive "${_workdir}/${strip_prefix}.zip")
+      set(_archive_fallback 1)
+    endif()
+  else()
+    set(_archive "${_workdir}/${strip_prefix}.zip")
+    set(_archive_fallback 1)
+  endif()
+  # Verify previously self-downloaded archive
+  if(_archive_fallback EQUAL 1)
+    if(EXISTS "${_archive}")
+      file(SHA256 "${_archive}" _checksum)
+      string(TOLOWER "${sha256}" _sha256_lower)
+      if(NOT ${_checksum} STREQUAL ${_sha256_lower})
+        message(STATUS "[OpenMeshCraft] ${_archive} SHA256 failed (expected: ${_sha256_lower}, got: ${_checksum}")
+        message(STATUS "[OpenMeshCraft] Removing invalid download ${_archive}")
+        file(REMOVE ${_archive})
+      endif()
+    endif()
+  endif()
+  # Download if archive doesn't exist
+  if(NOT EXISTS "${_archive}")
+    message(STATUS "[OpenMeshCraft] Downloading ${url}")
+    file(DOWNLOAD "${url}" "${_archive}" EXPECTED_HASH SHA256=${sha256} SHOW_PROGRESS STATUS _st)
+    list(GET _st 0 _code)
+    if(NOT _code EQUAL 0)
+      list(GET _st 1 _msg)
+      message(FATAL_ERROR "[OpenMeshCraft] Download failed: ${_msg}")
+    endif()
   endif()
+  file(MAKE_DIRECTORY "${_workdir}")
   set(_extract "${_workdir}/${strip_prefix}_extract")
   file(REMOVE_RECURSE "${_extract}")
   file(MAKE_DIRECTORY "${_extract}")
@@ -266,6 +298,7 @@ bambustudio_add_cmake_project(OpenMeshCraft
   ${_OMC_DEPENDS}
   PATCH_COMMAND ${CMAKE_COMMAND}
     -DOMC_SOURCE_DIR=<SOURCE_DIR>
+    -DDOWNLOAD_DIR=${DEP_DOWNLOAD_DIR}/OpenMeshCraft
     -P ${_OMC_GEN_DIR}/prepare_source.cmake
   COMMAND ${CMAKE_COMMAND} -E copy
     ${_OMC_DIR}/CMakeLists.txt.in
-- 
